# ─────────────────────────────────────────────────────────────────
#  BACKEND ENVIRONMENT VARIABLES — DO NOT COMMIT THIS FILE
#  Copy to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (Neon PostgreSQL) ───────────────────────────────────
# Get this from: https://neon.tech → New Project → Connection String
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING"
JWT_EXPIRES_IN="7d"

# ── Cloudinary ───────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Resend (Email) ───────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
NOTIFY_EMAIL="your@email.com"

# ── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
